# =====================================================================
#  JJ STORE · Configuración
#  Copia este archivo con el nombre .env y ajusta los valores.
# =====================================================================

# URL pública del sitio (se usa en los enlaces de los correos).
# Déjala vacía para detectarla automáticamente.
# Ejemplos: http://localhost:8000   ·   http://localhost/JJSTORE
APP_URL=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota

# Base de datos MySQL (valores por defecto de WAMP / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jjstore
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------------
# Correo
#   archivo -> no envía nada a internet: el correo queda guardado y se
#              puede ver con el botón "Ver correo" del pedido. Ideal para
#              presentar el proyecto sin conexión.
#   smtp    -> envía correos reales.
#
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords
# Usa esa contraseña de 16 letras en MAIL_PASSWORD (no tu clave normal).
# ---------------------------------------------------------------------
MAIL_DRIVER=archivo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="JJ STORE"
